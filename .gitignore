# The CLI repo contains only the installer, the README and src/.
# Anything else at the root is a project generated by `gosite create`,
# except the development-infrastructure entries whitelisted below
# (CI workflow, shellcheck config, bats test harness, openspec docs,
# template-extraction tooling).
/*
!/.gitignore
!/.githooks/
!/install.sh
!/README.md
!/CHANGELOG.md
!/MIGRATIONS.md
!/MEMORY.md
!/src/
!/docs/
!/.github/
!/.shellcheckrc
!/tests/
!/openspec/
!/tools/
