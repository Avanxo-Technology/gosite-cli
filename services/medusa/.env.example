# gosite-medusa environment (documentation).
# A site's generated compose file sets these; this file is for local runs only.

# sslmode=disable: the store's Postgres is on the private project network and
# speaks no TLS. Leaving it out makes Medusa attempt SSL and time out.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/gosite_medusa?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Generated per project by gosite create/generate, never committed.
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Region the store sells in: one of co, us.
COMMERCE_REGION=co

# Where the seed writes the publishable key for the site container to read.
COMMERCE_KEY_DIR=/run/gosite-commerce

# Admin user created once by the seed (password printed once in the log).
COMMERCE_ADMIN_EMAIL=admin@example.com

# Carts older than this are deleted by the daily cleanup job.
COMMERCE_CART_TTL_DAYS=30

# Browser origins allowed to use the Admin, on the shop.<site> subdomain.
ADMIN_CORS=https://shop.example.com
AUTH_CORS=https://shop.example.com
