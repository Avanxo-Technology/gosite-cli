{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "./.medusa/server",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "medusa-config.ts"],
  "exclude": ["node_modules", ".medusa"]
}
