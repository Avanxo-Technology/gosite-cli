{
  "name": "gosite-medusa",
  "version": "0.0.0",
  "private": true,
  "description": "gosite commerce engine: a pinned Medusa v2 with the gosite seed and cart cleanup.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "test:unit": "node --import ./tests/register-ts.mjs --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/knex": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "awilix": "^8.0.1",
    "nodemailer": "10.0.16",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@swc/core": "^1.7.42",
    "@swc/jest": "^0.2.39",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.2.14"
  }
}
