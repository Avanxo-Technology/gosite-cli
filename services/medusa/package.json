{
  "name": "gosite-medusa",
  "version": "0.0.0",
  "private": true,
  "description": "gosite commerce engine: a pinned Medusa v2 with the gosite seed and cart cleanup.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
