# syntax=docker/dockerfile:1
# generated by gosite generate from gosite.yml - do not edit.
# `gosite generate` rewrites this file. Put local changes in cockpit/config.local.php.
FROM cockpithq/cockpit:core-2.14.0

RUN install-php-extensions mongodb

# config.php merges config.core.php (gosite's) and config.local.php (the site's).
COPY cockpit/config.php cockpit/config.core.php cockpit/config.local.php /var/www/html/config/

# Every gosite addon is in the image; config.core.php disables the ones
# gosite.yml does not list (Cockpit's modules.disabled).
COPY --from=gosite-addons . /var/www/html/addons/