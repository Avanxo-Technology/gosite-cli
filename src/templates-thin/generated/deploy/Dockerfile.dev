# syntax=docker/dockerfile:1
# generated by gosite generate from gosite.yml - do not edit.
# `gosite generate` rewrites this file. Put local changes in docker-compose.override.yml.
# Local development only. The source tree is bind-mounted, so this image just
# carries the toolchain and runs air for hot reload.
FROM golang:1.26-alpine

RUN apk add --no-cache git curl

RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app
ENV PORT=8080 CGO_ENABLED=0
EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
